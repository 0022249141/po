{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset_manifest.schema.json",
  "title": "Trading Research Dataset Manifest",
  "type": "object",
  "required": ["dataset_id", "market", "symbol", "source_id", "data_type", "timezone", "file_path", "sha256", "rows", "validation"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "market": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "data_type": {"enum": ["ohlc", "tick", "macro_event", "trade_export", "other"]},
    "timeframe": {"type": ["string", "null"]},
    "timezone": {"type": "string", "minLength": 1},
    "normalization_timezone": {"type": ["string", "null"]},
    "start_timestamp": {"type": ["string", "null"]},
    "end_timestamp": {"type": ["string", "null"]},
    "analysis_cutoff": {"type": ["string", "null"]},
    "forming_bar_policy": {"type": ["string", "null"]},
    "file_path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "rows": {"type": "integer", "minimum": 0},
    "created_at": {"type": ["string", "null"]},
    "validation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not_run", "pass", "pass_with_warnings", "fail"]},
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "validator": {"type": ["string", "null"]}
      }
    }
  },
  "additionalProperties": true
}
